# Environment variables of the tests (APP_ENV=test, set by tests/bootstrap.php).
#
# This file is committed. config/core.php loads it in the test process and in the web server of the
# End-to-End tests, which inherits APP_ENV=test. Real environment variables win over it; put per-machine
# values in config/.env.test.local, which is ignored by git.

# The test database, for both connections ("test" for the fixtures, "default" for the web server). An SQLite
# file that both processes open, with an absolute path (four slashes): the web server runs in the document
# root, the tests in the project root, so a relative path would be two different files.
DATABASE_URL="sqlite:////tmp/pieceofcake2_panther_test_app.sqlite"
