# Environment variables of the tests (APP_ENV=test, set by tests/bootstrap.php).
#
# This file is committed. config/core.php loads it after config/.env in the test process and in the web
# server of the End-to-End tests, which inherits APP_ENV=test, so it holds only what the tests change.
# Real environment variables win over it. Put per-machine values in config/.env.test.local, which is
# ignored by git and loaded after it.

# The test database, for both connections ("test" for the fixtures, "default" for the web server). An SQLite
# file that both processes open, relative to the root of the repository (three slashes), where PHPUnit runs:
# the web server runs in the working directory of the tests too (PANTHER_WORKING_DIR). tmp/ is ignored by
# git; tests/bootstrap.php creates it.
DATABASE_URL="sqlite:///tmp/test_app.sqlite"
